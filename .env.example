# Server-only values. Never use NEXT_PUBLIC_ for these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key-or-legacy-service-role-key
CRON_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_PASSWORD=replace-with-unique-password-at-least-16-characters
DASHBOARD_SESSION_SECRET=replace-with-random-secret-at-least-32-characters
# Exact deployed origin, without a trailing slash; used for POST origin checks.
APP_URL=http://localhost:3000
# Optional HTTPS webhook. Receives a generic daily-review JSON notification.
# Only sent when notifications_enabled is true in the dashboard.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=

# Created by npm run aws:connect. Contains encrypted browser state + observed controls.
# Email used to start the interactive connection; keep your password out of this app.
AWS_BUILDER_ID_EMAIL=
# Store BOTH values as Vercel server-only secrets. Never paste them into chat.
AWS_SESSION_ENCRYPTED=
# 32 random bytes represented as 64 hexadecimal characters.
AWS_SESSION_KEY=
# Intended daily comment. Choose relevant content; AWS may moderate repetitive text.
AWS_COMMENT_TEXT=nice
# Optional local Chromium executable. Not required with installed Playwright browser.
AWS_LOCAL_CHROMIUM_PATH=
# Optional installed Chrome override for aws:connect -- --manual-browser.
AWS_MANUAL_CHROME_PATH=
